# ─── Supabase Configuration ───────────────────────────────────────────
# These are REQUIRED for the app to work. Without them, all data will be
# lost when Vercel's serverless functions restart (every ~2 days).
#
# 1. Go to https://supabase.com → Your Project → Settings → API
# 2. Copy the "Project URL" into SUPABASE_URL
# 3. Copy the "anon / public" key into SUPABASE_ANON_KEY
# 4. Also add these same values in Vercel: Project Settings → Environment Variables

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ─── Local Development Server ─────────────────────────────────────────
PORT=3000

# ─── FES Accounts App Integration (Server-to-Server) ──────────────────
FES_INTEGRATION_ENABLED=true
ACCOUNTS_APP_BASE_URL=http://localhost:3001
FES_INTEGRATION_API_KEY=your-64-char-hex-integration-api-key
FES_INTEGRATION_SECRET=your-64-char-hex-hmac-signing-secret
FES_INTEGRATION_TIMEOUT_MS=8000
